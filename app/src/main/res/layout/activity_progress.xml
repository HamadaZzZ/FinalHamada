<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main">

    <!-- الشريط العلوي -->
    <LinearLayout
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="24dp"
            android:layout_height="24dp"/>

        <TextView
            android:text="Progress"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <!-- التبويبات Weight / Calories -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tabWeight"
            android:text="Weight"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginEnd="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tabCalories"
            android:text="Calories"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#A0A0A0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- وزن المستخدم -->
    <LinearLayout
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Weight Trend"
            android:textColor="#555"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvWeight"
            android:text="155 lbs"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Last 30 Days   -2%"
            android:textColor="#009900"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <!-- مكان الرسم البياني -->
    <ImageView
        android:id="@+id/imgChart"
        android:layout_marginHorizontal="16dp"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:scaleType="fitXY"/>

    <!-- الكارت التحفيزي -->
    <LinearLayout
        android:orientation="horizontal"
        android:background="#F8F8F8"
        android:padding="16dp"
        android:layout_margin="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:elevation="2dp"
        android:clipToOutline="true"
        android:backgroundTint="#FFFFFF"
        android:backgroundTintMode="src_in"
        android:layout_gravity="center">

        <LinearLayout
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

            <TextView
                android:text="Weekly Summary"
                android:textColor="#888"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="You're doing great!"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="You've lost 1.5 lbs this week. Keep it up!"
                android:textColor="#555"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"/>
    </LinearLayout>

    <!-- شريط التنقل السفلي -->
    <LinearLayout
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:gravity="center"
        android:weightSum="5"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="🏠 Dashboard"
            android:gravity="center"
            android:layout_weight="1"
            android:textSize="12sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="➕ Add Food"
            android:gravity="center"
            android:layout_weight="1"
            android:textSize="12sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="🏋 Add Exercise"
            android:gravity="center"
            android:layout_weight="1"
            android:textSize="12sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="📈 Progress"
            android:textStyle="bold"
            android:textColor="#007AFF"
            android:gravity="center"
            android:layout_weight="1"
            android:textSize="12sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="👤 Profile"
            android:gravity="center"
            android:layout_weight="1"
            android:textSize="12sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>
    </LinearLayout>

</LinearLayout>
