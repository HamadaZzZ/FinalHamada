<?xml version="1.0" ?>
<LinearLayout
    xmlns:ns0="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    ns0:orientation="vertical"
    ns0:background="#FFFFFF"
    ns0:layout_width="match_parent"
    ns0:layout_height="match_parent"
    ns0:id="@+id/main">
    
    
    <LinearLayout
        ns0:orientation="horizontal"
        ns0:padding="16dp"
        ns0:gravity="center_vertical"
        ns0:layout_width="match_parent"
        ns0:layout_height="wrap_content">
        
        
        <ImageView
            ns0:id="@+id/btnMenu"
            ns0:layout_width="24dp"
            ns0:layout_height="24dp"/>
        
        
        <TextView
            ns0:text="Progress"
            ns0:textSize="20sp"
            ns0:textStyle="bold"
            ns0:layout_gravity="center"
            ns0:layout_weight="1"
            ns0:gravity="center"
            ns0:layout_width="0dp"
            ns0:layout_height="wrap_content"
            tools:ignore="DuplicateIds" />


    </LinearLayout>


    <LinearLayout
        ns0:orientation="horizontal"
        ns0:gravity="center"
        ns0:layout_marginBottom="8dp"
        ns0:layout_width="match_parent"
        ns0:layout_height="wrap_content">


        <TextView
            ns0:id="@+id/tabWeight"
            ns0:text="Weight"
            ns0:textSize="16sp"
            ns0:textStyle="bold"
            ns0:layout_marginEnd="20dp"
            ns0:layout_width="wrap_content"
            ns0:layout_height="wrap_content"/>


        <TextView
            ns0:id="@+id/tabCalories"
            ns0:text="Calories"
            ns0:textSize="16sp"
            ns0:textStyle="bold"
            ns0:textColor="#A0A0A0"
            ns0:layout_width="wrap_content"
            ns0:layout_height="wrap_content"/>


    </LinearLayout>


    <LinearLayout
        ns0:orientation="vertical"
        ns0:paddingStart="24dp"
        ns0:layout_width="match_parent"
        ns0:layout_height="wrap_content">


        <TextView
            ns0:text="Weight
            Trend"
            ns0:textColor="#555"
            ns0:textSize="14sp"
            ns0:layout_marginTop="8dp"
            ns0:layout_width="wrap_content"
            ns0:layout_height="wrap_content"
            ns0:id="@+id/tvWeightTrend"/>


        <TextView
            ns0:id="@+id/tvWeight"
            ns0:text="155
            lbs"
            ns0:textSize="32sp"
            ns0:textStyle="bold"
            ns0:textColor="#000"
            ns0:layout_width="wrap_content"
            ns0:layout_height="wrap_content"/>


        <TextView
            ns0:text="Last
            30
            Days
            -2%"
            ns0:textColor="#009900"
            ns0:textSize="14sp"
            ns0:layout_marginBottom="8dp"
            ns0:layout_width="wrap_content"
            ns0:layout_height="wrap_content"
            ns0:id="@+id/tvLast30Days2"/>


    </LinearLayout>


    <ImageView
        ns0:id="@+id/imgChart"
        ns0:layout_marginHorizontal="16dp"
        ns0:layout_width="match_parent"
        ns0:layout_height="200dp"
        ns0:scaleType="fitXY"/>


    <LinearLayout
        ns0:orientation="horizontal"
        ns0:background="#F8F8F8"
        ns0:padding="16dp"
        ns0:layout_margin="16dp"
        ns0:layout_width="match_parent"
        ns0:layout_height="wrap_content"
        ns0:gravity="center_vertical"
        ns0:layout_marginTop="8dp"
        ns0:elevation="2dp"
        ns0:clipToOutline="true"
        ns0:backgroundTint="#FFFFFF"
        ns0:backgroundTintMode="src_in"
        ns0:layout_gravity="center">


        <LinearLayout
            ns0:orientation="vertical"
            ns0:layout_weight="1"
            ns0:layout_width="0dp"
            ns0:layout_height="wrap_content">


            <TextView
                ns0:text="Weekly
                Summary"
                ns0:textColor="#888"
                ns0:textSize="14sp"
                ns0:layout_width="wrap_content"
                ns0:layout_height="wrap_content"
                ns0:id="@+id/tvWeeklySummary"/>


            <TextView
                ns0:text="You're
                doing
                great!"
                ns0:textStyle="bold"
                ns0:textSize="16sp"
                ns0:textColor="#000"
                ns0:layout_width="wrap_content"
                ns0:layout_height="wrap_content"
                ns0:id="@+id/tvYoureDoingGreat"/>


            <TextView
                ns0:text="You've
                lost
                1.5
                lbs
                this
                week.
                Keep
                it
                up!"
                ns0:textColor="#555"
                ns0:textSize="14sp"
                ns0:layout_width="wrap_content"
                ns0:layout_height="wrap_content"
                ns0:id="@+id/tvYouveLost15LbsThisWeekKeepItUp"/>


        </LinearLayout>


        <ImageView
            ns0:layout_width="80dp"
            ns0:layout_height="80dp"
            ns0:scaleType="centerCrop"/>


    </LinearLayout>


    <LinearLayout
        ns0:orientation="horizontal"
        ns0:background="#FFFFFF"
        ns0:gravity="center"
        ns0:weightSum="5"
        ns0:padding="8dp"
        ns0:layout_width="match_parent"
        ns0:layout_height="wrap_content">


        <TextView
            ns0:text="🏠
            Dashboard"
            ns0:gravity="center"
            ns0:layout_weight="1"
            ns0:textSize="12sp"
            ns0:layout_width="0dp"
            ns0:layout_height="wrap_content"
            ns0:id="@+id/tvDashboard"/>


        <TextView
            ns0:text="➕
            Add
            Food"
            ns0:gravity="center"
            ns0:layout_weight="1"
            ns0:textSize="12sp"
            ns0:layout_width="0dp"
            ns0:layout_height="wrap_content"
            ns0:id="@+id/tvAddFood"/>


        <TextView
            ns0:text="🏋
            Add
            Exercise"
            ns0:gravity="center"
            ns0:layout_weight="1"
            ns0:textSize="12sp"
            ns0:layout_width="0dp"
            ns0:layout_height="wrap_content"
            ns0:id="@+id/tvAddExercise"/>
        
        
        <TextView
            ns0:text="📈
            Progress"
            ns0:textStyle="bold"
            ns0:textColor="#007AFF"
            ns0:gravity="center"
            ns0:layout_weight="1"
            ns0:textSize="12sp"
            ns0:layout_width="0dp"
            ns0:layout_height="wrap_content"
            ns0:id="@+id/tvProgress"/>
        
        
        <TextView
            ns0:text="👤
            Profile"
            ns0:gravity="center"
            ns0:layout_weight="1"
            ns0:textSize="12sp"
            ns0:layout_width="0dp"
            ns0:layout_height="wrap_content"
            ns0:id="@+id/tvProfile"/>
        
        
    </LinearLayout>
    
    
</LinearLayout>