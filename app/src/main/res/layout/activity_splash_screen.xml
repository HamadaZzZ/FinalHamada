<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F9FA"
    tools:context=".SplashScreen"
    android:id="@+id/splashLayout">

    <!-- الخلفية: شخص يركض -->
    <ImageView
        android:id="@+id/bgRunner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:alpha="0.2"
        android:scaleType="centerInside" />

    <!-- دائرة تحتوي على علامة صح -->
    <ImageView
        android:id="@+id/checkIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="100dp" />

    <!-- اسم التطبيق -->
    <TextView
        android:id="@+id/appName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/checkIcon"
        android:layout_marginTop="16dp"
        android:layout_centerHorizontal="true"
        android:text="FitMate"
        android:textColor="#000000"
        android:textSize="32sp"
        android:textStyle="bold" />

    <!-- الوصف -->
    <TextView
        android:id="@+id/appSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/appName"
        android:layout_marginTop="8dp"
        android:layout_centerHorizontal="true"
        android:text="Your ultimate fitness companion."
        android:textColor="#666666"
        android:textSize="16sp" />

    <!-- شريط التحميل -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="24dp"
        android:progress="60"
        android:progressTint="#42A5F5"
        android:progressBackgroundTint="#BBDEFB" />
</RelativeLayout>
