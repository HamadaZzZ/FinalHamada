<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp">

    <!-- Top Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <ImageView
            android:id="@+id/btnClose"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentStart="true"
            android:contentDescription="Close" />

        <TextView
            android:id="@+id/tvAddExercise"
            android:text="Add Exercise"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_centerHorizontal="true"
            android:textColor="#000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </RelativeLayout>

    <!-- Categories Title -->
    <TextView
        android:id="@+id/tvCategories"
        android:text="Categories"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="#000"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <!-- Categories Grid -->
    <GridLayout
        android:columnCount="2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Cardio -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="6dp"
            android:padding="12dp"
            android:background="#DFFFD9"
            android:elevation="2dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1">

            <ImageView
                android:src="@android:drawable/ic_menu_myplaces"
                android:layout_width="36dp"
                android:layout_height="36dp" />

            <TextView
                android:id="@+id/tvCardio"
                android:text="Cardio"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#000"
                android:layout_marginTop="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Strength -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="6dp"
            android:padding="12dp"
            android:background="#DFFFD9"
            android:elevation="2dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1">

            <ImageView
                android:src="@android:drawable/ic_menu_manage"
                android:layout_width="36dp"
                android:layout_height="36dp" />

            <TextView
                android:id="@+id/tvStrength"
                android:text="Strength"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#000"
                android:layout_marginTop="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Yoga -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="6dp"
            android:padding="12dp"
            android:background="#DFFFD9"
            android:elevation="2dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1">

            <ImageView
                android:src="@android:drawable/ic_menu_gallery"
                android:layout_width="36dp"
                android:layout_height="36dp" />

            <TextView
                android:id="@+id/tvYoga"
                android:text="Yoga"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#000"
                android:layout_marginTop="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Cycling -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="6dp"
            android:padding="12dp"
            android:background="#DFFFD9"
            android:elevation="2dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1">

            <ImageView
                android:src="@android:drawable/ic_menu_compass"
                android:layout_width="36dp"
                android:layout_height="36dp" />

            <TextView
                android:id="@+id/tvCycling"
                android:text="Cycling"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#000"
                android:layout_marginTop="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

    </GridLayout>

    <!-- Quick Add -->
    <TextView
        android:id="@+id/tvQuickAdd"
        android:text="Quick Add"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="#000"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <!-- Quick Add Items -->
    <LinearLayout
        android:orientation="horizontal"
        android:background="#DFFFD9"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:layout_marginBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="2dp">

        <ImageView
            android:src="@android:drawable/ic_media_play"
            android:layout_width="32dp"
            android:layout_height="32dp" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvRunning"
                android:text="Running"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvN150Calories"
                android:text="150 calories"
                android:textColor="#555"
                android:textSize="12sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <ImageView
            android:src="@android:drawable/ic_input_add"
            android:layout_width="28dp"
            android:layout_height="28dp" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:background="#DFFFD9"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="2dp">

        <ImageView
            android:src="@android:drawable/ic_menu_agenda"
            android:layout_width="30dp"
            android:layout_height="30dp" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvWeightlifting"
                android:text="Weightlifting"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvN200Calories"
                android:text="200 calories"
                android:textColor="#555"
                android:textSize="12sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <ImageView
            android:src="@android:drawable/ic_input_add"
            android:layout_width="28dp"
            android:layout_height="28dp" />
    </LinearLayout>

    <!-- RecyclerView for added exercises -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvExercises"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp" />

    <!-- Add New Exercise Button -->
    <Button
        android:id="@+id/btnAddNewExercise"
        android:text="Add New Exercise +"
        android:backgroundTint="#00E000"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp" />

</LinearLayout>
