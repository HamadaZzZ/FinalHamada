<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp"
    android:id="@+id/main">

    <!-- 🔹 العنوان العلوي -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <ImageView
            android:id="@+id/btnClose"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:layout_alignParentStart="true"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Close"/>

        <TextView
            android:text="Add Exercise"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_centerHorizontal="true"
            android:textColor="#000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </RelativeLayout>

    <!-- 🔹 Categories Title -->
    <TextView
        android:text="Categories"
        android:textStyle="bold"
        android:textSize="22sp"
        android:textColor="#000"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- 🔹 Categories Grid -->
    <GridLayout
        android:columnCount="2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Category 1 -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:background="#DFFFD9"
            android:layout_margin="8dp"
            android:padding="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:backgroundTint="#DFFFD9"
            android:elevation="2dp"
            android:clipToOutline="true"
            android:layout_gravity="fill">

            <ImageView
                android:src="@android:drawable/ic_menu_myplaces"
                android:layout_width="40dp"
                android:layout_height="40dp"/>

            <TextView
                android:text="Cardio"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="8dp"
                android:textColor="#000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Category 2 -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:background="#DFFFD9"
            android:layout_margin="8dp"
            android:padding="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1">

            <ImageView
                android:src="@android:drawable/ic_menu_manage"
                android:layout_width="40dp"
                android:layout_height="40dp"/>

            <TextView
                android:text="Strength"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="8dp"
                android:textColor="#000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Category 3 -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:background="#DFFFD9"
            android:layout_margin="8dp"
            android:padding="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1">

            <ImageView
                android:src="@android:drawable/ic_menu_gallery"
                android:layout_width="40dp"
                android:layout_height="40dp"/>

            <TextView
                android:text="Yoga"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="8dp"
                android:textColor="#000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Category 4 -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:background="#DFFFD9"
            android:layout_margin="8dp"
            android:padding="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1">

            <ImageView
                android:src="@android:drawable/ic_menu_compass"
                android:layout_width="40dp"
                android:layout_height="40dp"/>

            <TextView
                android:text="Cycling"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="8dp"
                android:textColor="#000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

    </GridLayout>

    <!-- 🔹 Quick Add Section -->
    <TextView
        android:text="Quick Add"
        android:textStyle="bold"
        android:textSize="22sp"
        android:textColor="#000"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- Running -->
    <LinearLayout
        android:orientation="horizontal"
        android:background="#DFFFD9"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:layout_marginBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="2dp">

        <ImageView
            android:src="@android:drawable/ic_media_play"
            android:layout_width="40dp"
            android:layout_height="40dp"/>

        <LinearLayout
            android:orientation="vertical"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

            <TextView
                android:text="Running"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="150 calories"
                android:textColor="#555"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <ImageView
            android:src="@android:drawable/ic_input_add"
            android:layout_width="32dp"
            android:layout_height="32dp"/>
    </LinearLayout>

    <!-- Weightlifting -->
    <LinearLayout
        android:orientation="horizontal"
        android:background="#DFFFD9"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="2dp">

        <ImageView
            android:src="@android:drawable/ic_menu_agenda"
            android:layout_width="40dp"
            android:layout_height="40dp"/>

        <LinearLayout
            android:orientation="vertical"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

            <TextView
                android:text="Weightlifting"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="200 calories"
                android:textColor="#555"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <ImageView
            android:src="@android:drawable/ic_input_add"
            android:layout_width="32dp"
            android:layout_height="32dp"/>
    </LinearLayout>

    <!-- 🔹 زر أخضر في الأسفل -->
    <Button
        android:text="Add New Exercise  +"
        android:backgroundTint="#00E000"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:layout_gravity="bottom"/>
</LinearLayout>
