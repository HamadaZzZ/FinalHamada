<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="#F6F7F8"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main">

    <!-- ====== Header ====== -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">


        <TextView
            android:id="@+id/tvTitle"
            android:text="AddFood"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_centerHorizontal="true"
            android:textColor="#000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </RelativeLayout>

    <!-- ====== Search Bar ====== -->
    <LinearLayout
        android:orientation="horizontal"
        android:padding="8dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        tools:ignore="ExtraText">

        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp"
            android:layout_width="24dp"
            android:layout_height="24dp"/>

        ]>

        <EditText
            android:id="@+id/etSearchFood"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Search for a food"
            android:textColor="#000"
            android:textColorHint="#999"
            tools:ignore="TouchTargetSizeCheck" />
    </LinearLayout>

    <!-- ====== Today's Goal ====== -->
    <TextView
        android:id="@+id/tvTdGoal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:text="Today's Goal"
        android:textColor="#000"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Calories Progress -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_margin="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvCalrories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calories"
                android:textColor="#000"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvCAL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1200 / 2000 cal"
                android:textColor="#666"
                android:textSize="14sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressCalories"
            style="?android:attr/progressBarStyleHorizontal"
            android:progress="60"
            android:progressTint="#13a4ec"
            android:backgroundTint="#E0E0E0"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="8dp"/>
    </LinearLayout>

    <!-- ====== Recent Food List ====== -->
    <TextView
        android:id="@+id/tvRecent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp"
        android:text="Recent"
        android:textColor="#000"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:orientation="vertical"
            android:layout_marginBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- طعام رقم 1 -->
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginVertical="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:backgroundTint="#13a4ec"
                    android:layout_marginEnd="12dp"
                    android:layout_width="36dp"
                    android:layout_height="36dp"/>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvApple"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Apple"
                        android:textColor="#000"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvcalApple"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="150 cal"
                        android:textColor="#666"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- طعام رقم 2 -->
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginVertical="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:backgroundTint="#f44336"
                    android:layout_marginEnd="12dp"
                    android:layout_width="36dp"
                    android:layout_height="36dp"/>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvBanana"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Banana"
                        android:textColor="#000"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAddFood"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100 cal"
                        android:textColor="#666"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- طعام رقم 3 -->
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginVertical="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:backgroundTint="#ff9800"
                    android:layout_marginEnd="12dp"
                    android:layout_width="36dp"
                    android:layout_height="36dp"/>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvOrange"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Orange"
                        android:textColor="#000"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvcalOrange"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="80 cal"
                        android:textColor="#666"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- طعام رقم 4 -->
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginVertical="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:backgroundTint="#4caf50"
                    android:layout_marginEnd="12dp"
                    android:layout_width="36dp"
                    android:layout_height="36dp"/>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvBroccoli"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Broccoli"
                        android:textColor="#000"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvcalBroccoli"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="50 cal"
                        android:textColor="#666"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ====== Bottom Navigation ====== -->
    <LinearLayout
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:padding="8dp"
        android:elevation="4dp"
        android:gravity="center"
        android:weightSum="5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🏠 Home"
            android:textColor="#888" />

        <TextView
            android:id="@+id/tvGoals"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🎯 Goals"
            android:textColor="#888" />

        <TextView
            android:id="@+id/tvFood"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🍎 Food"
            android:textColor="#13a4ec"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvExcercises"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🏋 Exercise"
            android:textColor="#888" />

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📈 Progress"
            android:textColor="#888" />
    </LinearLayout>
</LinearLayout>
